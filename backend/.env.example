# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (секретный! только для бэкенда, никогда не кладите во frontend)
SUPABASE_SERVICE_KEY=

# Google AI Studio → Get API key (бесплатный тариф)
GEMINI_API_KEY=

# Запасной ИИ: console.groq.com → API Keys (бесплатно). Включается, когда у Gemini кончился лимит.
GROQ_API_KEY=

# Отдельный (не личный!) Instagram-аккаунт для сбора постов. Можно оставить пустым —
# тогда сборщики аккаунтов/хэштегов работают анонимно и с большими ограничениями.
IG_USERNAME=
IG_PASSWORD=
